{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Farewise",
      "type": "shell",
      "command": "bash scripts/dev.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Check Farewise",
      "type": "shell",
      "command": "bash scripts/check.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
