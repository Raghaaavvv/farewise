# Copy to backend/.env for bash scripts/dev.sh. Never commit real tokens.
# Leave approximate selected to run offline without external requests.
FAREWISE_ROUTING_PROVIDER=approximate

# Register at https://www.onemap.gov.sg/apidocs/ and generate an access token.
# Select onemap above to use driving routes. Tokens expire after three days.
ONEMAP_TOKEN=

# TrafficSpeedBands: a separate DataMall API AccountKey, not an SDK key.
# Requires OneMap route geometry. One background worker collects while the API runs.
FAREWISE_TRAFFIC_PROVIDER=off
LTA_ACCOUNT_KEY=
